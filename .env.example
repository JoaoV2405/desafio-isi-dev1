# Banco local de avaliação, criado pelo Docker Compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dev-junior-project

# Portas publicadas no host.
FRONTEND_PORT=3000
BACKEND_PORT=3003
POSTGRES_PORT=5432

# Única origem autorizada pelo CORS da API, sem caminho ou barra final.
FRONTEND_DOMAIN=http://localhost:3000

# Origem da API incorporada ao frontend durante o build, sem /api/v1.
VITE_API_ORIGIN=http://localhost:3003
